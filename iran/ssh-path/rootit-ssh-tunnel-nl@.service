[Unit]
Description=RoOtIt SSH SOCKS backhaul tunnel %i (TO-NL-SSH → MobinHost)
After=network-online.target
[Service]
ExecStart=/usr/bin/ssh -N -T -i /root/.ssh/rootit_tunnel_nl -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o IPQoS=throughput -o StrictHostKeyChecking=accept-new -D 127.0.0.1:%i rootit-tun@${NL_EXIT_IP}
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
