# vpn-infra-kit — copy to /root/.vpn-secrets/.env on the CONTROL host (Exit/master), chmod 600.
# Values with spaces/special chars ($ & ; ! quotes etc.) MUST be single-quoted: KEY='va$lue' (file is sourced by bash).
# NEVER commit the filled file. NEVER paste these values into chat — use a secure form/secret store.
# Values marked (auto) are generated by `install.sh --phase gen` if left empty.

########## 1. MODE ##########
# standalone = no shared master (like the original 2-server setup): Exit gets its own Pasarguard panel + sales panels
# master     = attach a NEW Iran node to an EXISTING Pasarguard master that already serves other nodes (add-only)
INSTALL_MODE=
# 1 = the Exit (e.g. Germany) is a DIFFERENT server from the master panel (3-server layout). See docs/SPLIT-EXIT.md
EXIT_SPLIT=0

# Each server below: *_AUTH=key|password. key -> *_SSH_KEY_FILE = path ON THE BOX to the private key (never inline it).
# *_OS is checked in preflight (supported: Ubuntu 22.04/24.04, Debian 12). *_PROVIDER / *_LOCATION are for docs/reports only.

########## 2a. IRAN NODE SERVER (users connect here) ##########
IRAN_IP=
IRAN_SSH_PORT=22
IRAN_SSH_USER=root
IRAN_AUTH=key
IRAN_SSH_KEY_FILE=
# secret
IRAN_SSH_PASSWORD=
IRAN_OS=
IRAN_PROVIDER=
IRAN_LOCATION=
# Optional private/LAN IP of the Iran host (leave empty if none)
IRAN_PRIVATE_IP=

########## 2b. EXIT SERVER (e.g. Germany; traffic leaves to the Internet here) ##########
EXIT_IP=
EXIT_SSH_PORT=22
EXIT_SSH_USER=root
EXIT_AUTH=key
EXIT_SSH_KEY_FILE=
# secret
EXIT_SSH_PASSWORD=
EXIT_OS=
EXIT_PROVIDER=
EXIT_LOCATION=

########## 2c. MASTER PANEL SERVER (Pasarguard; manages users). Same as Exit when EXIT_SPLIT=0 ##########
MASTER_IP=
MASTER_SSH_PORT=22
MASTER_SSH_USER=root
# key|password|none (none = panel API only, no SSH to the master — recommended for a friend's master)
MASTER_AUTH=none
MASTER_SSH_KEY_FILE=
# secret
MASTER_SSH_PASSWORD=
MASTER_OS=
MASTER_PROVIDER=
MASTER_LOCATION=

########## 3. PASARGUARD MASTER PANEL ##########
# Panel base URL reachable from the host running the installer (e.g. https://panel.example.com or http://127.0.0.1:8000)
PASARGUARD_URL=
# Panel version shown in the dashboard (e.g. v1.x dev); preflight compares with the API
PASARGUARD_VERSION=
# Auth: EITHER a temporary panel API key (pg_key_...) — preferred, revoke after install —
# OR an admin username + password. NOTE: the failover timer needs long-lived auth; with a temporary key,
# give it a long-lived key or admin login before revoking. (secret)
PASARGUARD_API_KEY=
PASARGUARD_ADMIN_USER=
# secret
PASARGUARD_ADMIN_PASS=
# Existing docker container name of the panel (standalone mode creates "pasarguard")
PASARGUARD_CONTAINER=pasarguard

########## 4. NAMING (asked in setup; must be unique on the master) ##########
# Short prefix for every object/unit/nft table the kit creates (e.g. fk1)
KIT_PREFIX=
# Node and core-config names on the panel (empty = ${KIT_PREFIX}-iran / ${KIT_PREFIX}-iran-core)
PG_NODE_NAME=
PG_CORE_NAME=
# Existing panel group(s) the new inbounds are appended to (comma list). Users in these groups get the new hosts.
PG_GROUPS=
# 1 = create any listed group that does not exist yet
PG_GROUP_CREATE=0
# Subscription host remark template; placeholders {prefix} {proto} {tag} {node}. e.g. "{prefix}-{proto}" -> fk1-VLESS-REALITY
HOST_REMARK_TEMPLATE={prefix}-{proto}
# Address put in hosts (users connect to it). Empty = IRAN_DOMAIN, else IRAN_IP
HOST_ADDRESS=
# Inbound tags NOT to publish as hosts (comma list)
HOST_SKIP_TAGS=
HOST_PRIORITY=1

########## 5. PATH PRIORITY ##########
# Comma list of reality,xhttp,gcore,bunny,cf,direct. Empty = mode default:
#   standalone: reality,xhttp,gcore,bunny,cf,direct   master: xhttp,gcore,cf,reality,direct (CDN-first, hides master IP)
# cforange is always watch-only.
PATH_PRIORITY=

########## SPLIT details ##########
# CDN origin port served by the kit xray with TLS (must be free on Exit; CF orange needs an Origin Rule to this port)
XHTTP_ORIGIN_PORT=10443
# port Iran uses for the CF-gray path: 443 normally, XHTTP_ORIGIN_PORT in split mode (auto)
CF_GRAY_PORT=443
XRAY_VERSION=v25.10.15

########## 6. TLS / Let's Encrypt ##########
# Let's Encrypt account email (expiry notices). Cert via acme.sh DNS-01 using CF_DNS_TOKEN
ACME_EMAIL=
# secret — token with ONLY Zone.DNS:Edit on the kit zones
CF_DNS_TOKEN=

# Node API key for the new pg-node on Iran (auto)
PG_NODE_API_KEY=
# pg-node image tag; must match the master's panel version family
PG_NODE_IMAGE=pasarguard/node:latest
# Filled by the installer after creation (do not set by hand)
PG_CORE_ID=
PG_NODE_ID=
PG_GROUP_ID=

########## 7. DOMAINS (one hostname per path; empty = path skipped) ##########
MAIN_ZONE=
PANEL_DOMAIN=
IRAN_DOMAIN=
# XHTTP over CDN (CF gray-cloud or any CDN in front of Exit:443)
XHTTP_DOMAIN=
# CF gray (DNS-only, points at EXIT_IP)
CF_GRAY_DOMAIN=
# CF orange (proxied) — watch-only canary
CFORANGE_DOMAIN=
GCORE_DOMAIN=
GCORE_CDN_HOSTNAME=
BUNNY_DOMAIN=
BUNNY_PULLZONE_HOST=
# Optional extra aliases (leave empty to skip)
PANEL_DOMAIN_ALT=
PANEL_DOMAIN_EXTRA=
XHTTP_DOMAIN_ALT=
CF_GRAY_DOMAIN_ALT=
IRAN_DOMAIN_ALT=
ALT_ZONE=
BUNNY_ZONE=
GCORE_ZONE=
EXTRA_ZONE=
GCORE_CNAME_DOMAIN=
GITHUB_OWNER=

########## BACKHAUL SECRETS (auto) ##########
XRAY_BRIDGE_UUID=
# random path like /a1b2c3/v1 (auto)
XHTTP_PATH=
# REALITY bridge Iran→Exit on REALITY_PORT; nft allows only IRAN_IP
REALITY_PORT=8444
REALITY_DEST=www.apple.com
REALITY_SERVER_NAME=www.apple.com
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
# Iran user-facing REALITY inbound (auto)
REALITY_CLIENT_PRIVATE_KEY=
REALITY_CLIENT_SHORT_ID=
REALITY_CLIENT_SNI=dl.google.com
# "" in standalone, "${KIT_PREFIX}-" in master mode (inbound tags are global in Pasarguard)
INBOUND_PREFIX=
PG_NODE_PORT=62050
# internal ports on Exit (change if they collide on a shared master)
XHTTP_BRIDGE_PORT=10443
DIRECT_TLS_PORT=9443
SOCKS_TEST_PORT=10808

########## 8. CLOUDFLARE ##########
# secret — Custom token scoped to the zones below: Zone Read, DNS Edit, Zone Settings Edit, Cache Rules Edit, Firewall Services Edit
CF_API_TOKEN=
# Zone name(s) used by the kit (comma list) — CF_ZONE_ID is looked up automatically if empty
CF_ZONES=
CF_ACCOUNT_ID=
CF_ZONE_ID=

########## 9. GCORE (optional path) ##########
# secret — Gcore permanent API token
GCORE_API_TOKEN=
# !! GCORE_DOMAIN must be on a NON-.ir domain: Gcore rejects .ir hostnames for CDN resources.

########## 10. BUNNY (optional path) ##########
# secret — Bunny account API key
BUNNY_API_KEY=
# !! The Bunny account must have a FUNDED balance; when it hits $0 / trial ends, the pull zone stops serving (403 / cert mismatch).

########## WARP (optional egress) ##########
WARP_PRIVATE_KEY=
WARP_PEER_PUBLIC_KEY=
WARP_ENDPOINT=
WARP_ADDRESSES=
WARP_RESERVED=

########## TLS ##########
TLS_CERT_FILE=/root/.pg_nodes/certs/fullchain.pem
TLS_KEY_FILE=/root/.pg_nodes/certs/privkey.pem

########## WEB PANELS (asked at setup; 1 = install) — honored in standalone, master and split ##########
# Failover web panel (path-web): current path, per-path health, auto/manual switch (kit core only)
INSTALL_PANEL_FAILOVER=0
# Instagram multiplier web panel (ig-mult-web)
INSTALL_PANEL_IG=0
# Sales web panel (settle-web; in master mode it sells on the SHARED master panel)
INSTALL_PANEL_SALES=0
# path-web: hostname (split: CF proxied + Origin Rule -> PATH_WEB_PORT), port, login (password auto-generated if empty)
PATH_WEB_DOMAIN=
PATH_WEB_PORT=8790
PATH_WEB_USER=admin
PATH_WEB_PASS=
########## PANELS (standalone mode; optional in master mode) ##########
PANEL_BASIC_AUTH_USER=
PANEL_BASIC_AUTH_PASS=
PANEL_API_KEY=

########## 11. BACKUP (daily GPG archive to Telegram) ##########
# 1 = install RoOtIt-backup (scripts/rootit-backup.sh) on Iran + Exit (+ Master in split mode); 0 = skip
INSTALL_BACKUP=1
# daily time, Asia/Tehran (Exit runs +10 min, Master +20 min)
BACKUP_TIME=04:00
# local archives in /root/RoOtIt-backups older than N days are deleted (0 = keep all)
BACKUP_RETENTION_DAYS=14
# master DB container for the read-only pg_dump (split mode)
BACKUP_PG_CONTAINER=pasarguard-timescaledb-1
# per-host BACKUP_GPG_PASS is generated ON each host in its /root/.vpn-secrets/.env (never here)
# secret — from @BotFather; the bot must be able to message TELEGRAM_CHAT_ID (send /start to it first)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (auto) — STORE OFFLINE; without it the backups cannot be decrypted
BACKUP_PASSPHRASE=

########## PANEL <-> NODE CONTROL LINK ##########
# tunnel = panel reaches the Iran node API THROUGH the backhaul tunnel (xray reverse proxy); node API bound to 127.0.0.1 on Iran.
# direct = classic: panel dials IRAN_IP:PG_NODE_PORT; Iran nft accepts that port ONLY from EXIT_IP.
CTL_MODE=tunnel
# 1 = also keep the direct path open (Iran nft: PG_NODE_PORT from EXIT_IP only) as an emergency fallback
CTL_DIRECT_FALLBACK=0
# Local-only port on Exit/master where the panel connects in tunnel mode
CTL_LOCAL_PORT=62051
# Address the panel uses to reach CTL_LOCAL_PORT. 127.0.0.1 if the panel container uses host networking,
# otherwise the docker bridge gateway (e.g. 172.17.0.1) — then set CTL_LISTEN to the same address.
CTL_NODE_ADDRESS=127.0.0.1
CTL_LISTEN=127.0.0.1
# Tunnel outbounds the control link may use (leastPing between them)
CTL_PATHS=TO-AMS-XHTTP,TO-AMS-REALITY
