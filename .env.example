# vpn-infra-kit — copy to /root/.vpn-secrets/.env on the CONTROL host (Exit/master), chmod 600.
# Values with spaces/special chars ($ & ; ! quotes etc.) MUST be single-quoted: KEY='va$lue' (file is sourced by bash).
# NEVER commit the filled file. NEVER paste these values into chat — use a secure form/secret store.
# Values marked (auto) are generated by `install.sh --phase gen` if left empty.

########## MODE ##########
# Choose ONE:
#   standalone = no shared master: a fresh Exit server with its own Pasarguard panel + panels/sales (like the original setup)
#   master     = attach a new Iran node to an EXISTING Pasarguard master that already serves other nodes (add-only)
# standalone = new Exit server with its own Pasarguard panel (full stack, panels, sales)
# master     = attach a NEW Iran node + tunnel to an EXISTING Pasarguard master that already serves other nodes
INSTALL_MODE=master
# Failover order (comma list of tags or short names reality,xhttp,gcore,bunny,cf,direct). Empty = mode default:
#   standalone: reality,xhttp,gcore,bunny,cf,direct   master: xhttp,gcore,cf,reality,direct (CDN-first, hides master IP)
# cforange is always watch-only and is ignored here.
PATH_PRIORITY=
# Unique prefix for every object this kit creates on a shared master (inbounds, outbounds, node, core config, nft table, units)
KIT_PREFIX=ikit

########## EXIT / MASTER (Germany) ##########
EXIT_IP=
EXIT_SSH_PORT=22
EXIT_SSH_USER=root
# Prefer key auth: path ON THE BOX to a private key (never inline the key)
EXIT_SSH_KEY_FILE=
EXIT_SSH_PASSWORD=
EXIT_PROVIDER=

########## SPLIT: Exit host != Pasarguard master ##########
# 1 = EXIT_* above is a separate server (e.g. an existing node host); master gets only panel API objects.
# Run the installer ON the Exit host (installer/ship_to_exit.sh from your workstation). See docs/SPLIT-EXIT.md
EXIT_SPLIT=0
MASTER_IP=
# public panel URL reachable from the Exit (e.g. https://panel.example.com) — set PASARGUARD_URL to it in split mode
# CDN origin port served by the kit xray with TLS (must be free on Exit; CF orange needs an Origin Rule to this port)
XHTTP_ORIGIN_PORT=10443
# port Iran uses for the CF-gray path (DNS-only => hits Exit directly): 443 normally, XHTTP_ORIGIN_PORT in split mode (auto)
CF_GRAY_PORT=443
XRAY_VERSION=v25.10.15
# Origin cert via acme.sh DNS-01 on the Exit; prefer a token with ONLY Zone.DNS:Edit on the kit zones
CF_DNS_TOKEN=
ACME_EMAIL=
########## IRAN NODE ##########
IRAN_IP=
IRAN_SSH_PORT=22
IRAN_SSH_USER=root
IRAN_SSH_KEY_FILE=
IRAN_SSH_PASSWORD=
IRAN_PROVIDER=
# Optional private/LAN IP of the Iran host (leave empty if none)
IRAN_PRIVATE_IP=

########## PASARGUARD ##########
# Panel base URL as reachable FROM THE EXIT/MASTER HOST (e.g. http://127.0.0.1:8000)
PASARGUARD_URL=http://127.0.0.1:8000
PASARGUARD_ADMIN_USER=
PASARGUARD_ADMIN_PASS=
# Existing docker container name of the panel on master (standalone mode creates "pasarguard")
PASARGUARD_CONTAINER=pasarguard
# Node API key for the new pg-node on Iran (auto)
PG_NODE_API_KEY=
# pg-node image tag; must match the master's panel version family
PG_NODE_IMAGE=pasarguard/node:latest
# Filled by the installer after creation (do not set by hand)
PG_CORE_ID=
PG_NODE_ID=
PG_GROUP_ID=

########## DOMAINS (one hostname per path; all must resolve) ##########
MAIN_ZONE=
PANEL_DOMAIN=
IRAN_DOMAIN=
# XHTTP over CDN (CF gray-cloud or any CDN in front of Exit:443)
XHTTP_DOMAIN=
# CF gray (DNS-only, points at EXIT_IP)
CF_GRAY_DOMAIN=
# CF orange (proxied) — watch-only canary
CFORANGE_DOMAIN=
GCORE_DOMAIN=
GCORE_CDN_HOSTNAME=
BUNNY_DOMAIN=
BUNNY_PULLZONE_HOST=
# Optional extra aliases (leave empty to skip)
PANEL_DOMAIN_ALT=
PANEL_DOMAIN_EXTRA=
XHTTP_DOMAIN_ALT=
CF_GRAY_DOMAIN_ALT=
IRAN_DOMAIN_ALT=
ALT_ZONE=
BUNNY_ZONE=
GCORE_ZONE=
EXTRA_ZONE=
GCORE_CNAME_DOMAIN=
GITHUB_OWNER=

########## BACKHAUL SECRETS (auto) ##########
XRAY_BRIDGE_UUID=
# random path like /a1b2c3/v1 (auto)
XHTTP_PATH=
# REALITY bridge Iran→Exit on REALITY_PORT; nft allows only IRAN_IP
REALITY_PORT=8444
REALITY_DEST=www.apple.com
REALITY_SERVER_NAME=www.apple.com
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
# Iran user-facing REALITY inbound (auto)
REALITY_CLIENT_PRIVATE_KEY=
REALITY_CLIENT_SHORT_ID=
REALITY_CLIENT_SNI=dl.google.com
# "" in standalone, "${KIT_PREFIX}-" in master mode (inbound tags are global in Pasarguard)
INBOUND_PREFIX=
PG_NODE_PORT=62050
# internal ports on Exit (change if they collide on a shared master)
XHTTP_BRIDGE_PORT=10443
DIRECT_TLS_PORT=9443
SOCKS_TEST_PORT=10808

########## CLOUDFLARE ##########
# Custom token scoped to MAIN_ZONE: Zone Read, DNS Edit, Zone Settings Edit, Cache Rules Edit, Firewall Services Edit
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

########## GCORE / BUNNY (optional paths; leave empty to skip) ##########
GCORE_API_TOKEN=
BUNNY_API_KEY=

########## WARP (optional egress) ##########
WARP_PRIVATE_KEY=
WARP_PEER_PUBLIC_KEY=
WARP_ENDPOINT=
WARP_ADDRESSES=
WARP_RESERVED=

########## TLS ##########
TLS_CERT_FILE=/root/.pg_nodes/certs/fullchain.pem
TLS_KEY_FILE=/root/.pg_nodes/certs/privkey.pem

########## PANELS (standalone mode; optional in master mode) ##########
PANEL_BASIC_AUTH_USER=
PANEL_BASIC_AUTH_PASS=
PANEL_API_KEY=

########## BACKUP ##########
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (auto) — STORE OFFLINE; without it the backups cannot be decrypted
BACKUP_PASSPHRASE=

########## PANEL <-> NODE CONTROL LINK ##########
# tunnel = panel reaches the Iran node API THROUGH the backhaul tunnel (xray reverse proxy); node API bound to 127.0.0.1 on Iran.
# direct = classic: panel dials IRAN_IP:PG_NODE_PORT; Iran nft accepts that port ONLY from EXIT_IP.
CTL_MODE=tunnel
# 1 = also keep the direct path open (Iran nft: PG_NODE_PORT from EXIT_IP only) as an emergency fallback
CTL_DIRECT_FALLBACK=0
# Local-only port on Exit/master where the panel connects in tunnel mode
CTL_LOCAL_PORT=62051
# Address the panel uses to reach CTL_LOCAL_PORT. 127.0.0.1 if the panel container uses host networking,
# otherwise the docker bridge gateway (e.g. 172.17.0.1) — then set CTL_LISTEN to the same address.
CTL_NODE_ADDRESS=127.0.0.1
CTL_LISTEN=127.0.0.1
# Tunnel outbounds the control link may use (leastPing between them)
CTL_PATHS=TO-AMS-XHTTP,TO-AMS-REALITY
