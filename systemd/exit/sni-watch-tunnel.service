[Unit]
Description=SSH tunnel to Iran sni-watch (127.0.0.1:8787)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:8787:127.0.0.1:8787 root@${IRAN_IP}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
